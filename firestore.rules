rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Dispenser Documents
    match /dispensers/{dispenserId} {
      // ✅ flutter APP READ ACCESS: Anyone authenticated can read the base attributes (including the 'schedule' map!)
      allow read: if request.auth != null;
      
      // ✅ flutter APP WRITE ACCESS: Flutter can create/update the base dispenser document (including modifying the 'schedule' map!)
      allow write: if request.auth != null;

      // The critical state subcollection
      match /current_state/data {
        // ✅ flutter APP READ ACCESS: Anyone authenticated can securely RED the live hardware state (Battery, WiFi, Locks, etc.)
        allow read: if request.auth != null;
        
        // Block Flutter from creating/overwriting the document entirely
        // Allow updates ONLY if they are modifying the specific doses fields
        allow write: if request.auth != null 
                     && request.auth.uid != null
                     && (
                         // If it's the ESP32 hardware making the request (using an API key/Custom Token, or we can assume if it's not a standard App user)
                         // OR if it's the Flutter app, strictly limit the payload to only dose modifications:
                         request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['doses_remaining', 'operational'])
                     );
      }

      // Allow full access to users subcollection
      match /users/{document=**} {
        allow read, write: if request.auth != null;
      }
      
      match /rfid_tags/{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Alerts Collection requires no special Flutter write access, only cloud functions and ESP32
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Ideally restrict strictly to ESP32
    }
  }
}
